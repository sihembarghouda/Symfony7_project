{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2 class="text-white font-weight-bold">Connexion</h2>
        
        {% if error %}
            <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        
        {% for flash_error in app.flashes('error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}
        
        <form action="{{ path('app_connexion') }}" method="post">
            <div class="mb-3">
                <label for="email" class="form-label text-white font-weight-bold">Email :</label>
                <input type="email" id="email" name="email" value="{{ last_username|default('') }}" class="form-control custom-width" placeholder="Entrez votre email" required autofocus aria-label="Email de connexion">
            </div>
            <div class="mb-3">
                <label for="password" class="form-label text-white font-weight-bold">Mot de passe :</label>
                <input type="password" id="password" name="password" class="form-control custom-width" placeholder="Entrez votre mot de passe" required aria-label="Mot de passe de connexion">
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div class="mb-3 form-check">
                <input type="checkbox" id="remember_me" name="_remember_me" class="form-check-input">
                <label for="remember_me" class="form-check-label text-white font-weight-bold">Se souvenir de moi</label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Se connecter</button>
        </form>
        
        <div class="mt-3 text-center">
            <p class="text-white">
                Pas encore de compte ? 
                <a href="{{ path('app_inscription') }}" class="text-white font-weight-bold">Inscrivez-vous ici</a>
            </p>
        </div>
    </div>

    <!-- Style CSS pour la largeur -->
    <style>
        .custom-width {
            width: 100%;  /* Assure une largeur de 100% */
        }

        .btn-lg {
            padding: 0.75rem 1.25rem;  /* Augmente la taille du bouton */
        }

        .text-white {
            color: white !important;
        }
    </style>
{% endblock %}
