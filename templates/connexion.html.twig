{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2 style="color: white; font-weight: bold;">Connexion</h2>
        
        {% if error %}
            <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        
        {% for flash_error in app.flashes('error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}
        
        <form action="{{ path('app_connexion') }}" method="post">
            <div class="mb-3">
                <label for="email" class="form-label" style="color: white; font-weight: bold;">Email :</label>
                <input type="email" id="email" name="email" value="{{ last_username|default('') }}" class="form-control custom-width" required autofocus>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label" style="color: white; font-weight: bold;">Mot de passe :</label>
                <input type="password" id="password" name="password" class="form-control custom-width" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div class="mb-3 form-check">
                <input type="checkbox" id="remember_me" name="_remember_me" class="form-check-input">
                <label for="remember_me" class="form-check-label" style="color: white; font-weight: bold;">Se souvenir de moi</label>
            </div>
            <button type="submit" class="btn btn-primary">Se connecter</button>
        </form>
        <div class="mt-3">
            <p style="color: white;">
                Pas encore de compte ?
                <a href="{{ path('app_inscription') }}" style="color: white; font-weight: bold;">Inscrivez-vous</a>
            </p>
        </div>
    </div>

    <!-- Ajout d'un style CSS pour forcer la largeur -->
    <style>
        .custom-width {
            width: 100%;  /* Assure une largeur de 100% */
        }
    </style>
{% endblock %}
