{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2 style="color: white; font-weight: bold;">Inscription</h2>

        <form action="{{ path('app_register') }}" method="post">
            <div class="mb-3">
                <label for="username" class="form-label" style="color: white; font-weight: bold;">Nom d'utilisateur :</label>
                <input type="text" id="username" name="username" class="form-control custom-width" required autofocus>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label" style="color: white; font-weight: bold;">Email :</label>
                <input type="email" id="email" name="email" class="form-control custom-width" required>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label" style="color: white; font-weight: bold;">Mot de passe :</label>
                <input type="password" id="password" name="password" class="form-control custom-width" required>
            </div>

            <div class="mb-3">
                <label for="password_confirm" class="form-label" style="color: white; font-weight: bold;">Confirmer le mot de passe :</label>
                <input type="password" id="password_confirm" name="password_confirm" class="form-control custom-width" required>
            </div>

            <button type="submit" class="btn btn-primary">S'inscrire</button>
        </form>

        <div class="mt-3">
            <p style="color: white;">
                Déjà un compte ? <a href="{{ path('app_login') }}" style="color: white; font-weight: bold;">Connectez-vous</a>
            </p>
        </div>
    </div>

    <!-- Style CSS pour forcer la largeur -->
    <style>
        .custom-width {
            width: 100%;  /* Assure une largeur de 100% */
        }
    </style>
{% endblock %}
