{# templates/registration/confirmation_email.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Confirmation de votre email</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5">
        <h1 class="text-center mb-4">Bienvenue parmi nous !</h1>
        <p class="lead text-center">Veuillez confirmer votre adresse e-mail pour finaliser votre inscription.</p>

        <p class="text-center">
            Cliquez sur le lien suivant pour confirmer votre email : <br><br>
            <a href="{{ signedUrl|raw }}" class="btn btn-primary">Confirmer mon Email</a>
        </p>

        <p class="text-center">
            Ce lien expirera dans {{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}.
        </p>

        <p class="text-center">
            Si vous n'avez pas demandé d'inscription, vous pouvez ignorer cet email.<br><br>
            À bientôt,<br>
            L'équipe de votre boutique
        </p>
    </div>
</body>
</html>
