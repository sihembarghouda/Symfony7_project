{% extends 'base.html.twig' %}

{% block body %}
    <div class="container text-center py-5">
        <!-- Titre principal -->
        <h1 class="mb-4">À propos de notre boutique</h1>

        <!-- Paragraphe de présentation en gras -->
        <p style="font-weight: bold; color: black; max-width: 700px; margin: 0 auto 20px auto;">
            Découvrez notre boutique en ligne dédiée aux parfums de luxe. Nous vous proposons une sélection raffinée de fragrances pour femmes et hommes, alliant élégance, authenticité et qualité. Chaque parfum raconte une histoire… la vôtre.
        </p>

        <!-- Signature -->
        <p style="font-style: italic; color: #555;">L'équipe de votre parfumerie de luxe</p>

        <!-- Bouton retour -->
        <a href="{{ path('app_home') }}" class="btn btn-primary mt-4">
            Retour à l'accueil
        </a>
    </div>
{% endblock %}
