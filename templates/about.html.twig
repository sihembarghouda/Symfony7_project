{% extends 'base.html.twig' %}

{% block body %}
    <div style="text-align: center; padding: 40px;">
        <!-- Titre principal -->
        

        <!-- Paragraphe de présentation en gras -->
        <p style="font-weight: bold; color: black; max-width: 700px; margin: 0 auto 20px auto;">
